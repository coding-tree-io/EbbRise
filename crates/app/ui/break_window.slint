// Break window, design "B1 · Ring, centred · chosen palette".
// Colours: OKLCH ramps (neutral hue 160, accent hue 155) written as hex; contrast measured
// on the glow, the lightest ground: text 12.9:1, secondary 8.3:1, accent label 7.0:1.

global Palette {
    out property <color> ground: #0F1612;
    out property <color> glow: #192E21;
    out property <color> ring-track: #2E3531;
    out property <color> ring-light: #ABF1C3;
    out property <color> ring-deep: #67A97F;
    out property <color> text: #EBF4EF;
    out property <color> text-secondary: #BEC7C1;
    out property <color> accent: #79C594;
    out property <color> accent-hover: #89DDA7;
    out property <color> on-accent: #0F1612;
    out property <color> button: #181F1B;
    out property <color> button-hover: #222824;
    out property <color> button-border: #6C746F;
    out property <color> focus: #89DDA7;
}

// Icon strokes in a 24 × 24 view box.
component Icon inherits Path {
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <string> icon;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 44px;
    border-radius: self.height / 2;
    background: root.primary
        ? (touch.has-hover ? Palette.accent-hover : Palette.accent)
        : (touch.has-hover ? Palette.button-hover : Palette.button);
    border-width: root.primary ? 0 : 1px;
    border-color: Palette.button-border;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                stroke: root.primary ? Palette.on-accent : Palette.text;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 15px;
            font-weight: root.primary ? 600 : 400;
            color: root.primary ? Palette.on-accent : Palette.text;
        }
    }
    // Focus ring, 2 px outside the pill.
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: self.height / 2;
        border-width: focus.has-focus ? 2px : 0;
        border-color: Palette.focus;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component BreakWindow inherits Window {
    in property <string> kind;
    in property <string> headline;
    in property <string> detail;
    in property <string> number;
    in property <string> caption;
    // SVG path commands for the arc of time left, in the ring's 236 × 236 view box.
    in property <string> ring;
    in property <string> postpone-label;
    in property <string> skip-label;
    in property <string> finish-label;
    in property <bool> show-postpone;
    in property <bool> show-skip;
    in property <bool> show-finish;
    callback postpone();
    callback skip();
    callback finish();

    title: root.kind;
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI Variable Text";
    background: Palette.ground;

    // The glow centres on the ring. Its radius is 0.6 × the shorter side; the default radius
    // is half the diagonal (0.85 × the square's side), so the glow ends at 71 %.
    Rectangle {
        width: min(root.width, root.height) * 1.2;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.height * 0.3 - self.height / 2;
        background: @radial-gradient(circle, Palette.glow 0%, Palette.ground 71%);
    }

    VerticalLayout {
        alignment: center;
        spacing: 26px;
        padding: 32px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 236px;
                height: 236px;
                Path {
                    width: 236px;
                    height: 236px;
                    viewbox-width: 236;
                    viewbox-height: 236;
                    commands: "M 118 10 A 108 108 0 1 1 118 226 A 108 108 0 1 1 118 10";
                    stroke: Palette.ring-track;
                    stroke-width: 10px;
                }
                Path {
                    width: 236px;
                    height: 236px;
                    viewbox-width: 236;
                    viewbox-height: 236;
                    commands: root.ring;
                    stroke: @linear-gradient(135deg, Palette.ring-light 0%, Palette.ring-deep 100%);
                    stroke-width: 10px;
                    stroke-line-cap: round;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.number;
                        horizontal-alignment: center;
                        font-family: "Segoe UI Variable Display";
                        font-size: 80px;
                        font-weight: 200;
                        color: Palette.text;
                    }
                    Text {
                        text: root.caption;
                        horizontal-alignment: center;
                        font-size: 13px;
                        color: Palette.text-secondary;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            alignment: center;
            Text {
                text: root.kind.to-uppercase();
                horizontal-alignment: center;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1.4px;
                color: Palette.accent;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.headline;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-family: "Segoe UI Variable Display";
                    font-size: 32px;
                    font-weight: 600;
                    color: Palette.text;
                    max-width: 620px;
                }
            }
            if root.detail != "": HorizontalLayout {
                alignment: center;
                Text {
                    text: root.detail;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-size: 15px;
                    color: Palette.text-secondary;
                    max-width: 620px;
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            if root.show-postpone: PillButton {
                text: root.postpone-label;
                icon: "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 M 12 7 L 12 12 L 15 14";
                clicked => { root.postpone(); }
            }
            if root.show-skip: PillButton {
                text: root.skip-label;
                primary: true;
                icon: "M 5 5 L 14 12 L 5 19 Z M 18 5 L 18 19";
                clicked => { root.skip(); }
            }
            if root.show-finish: PillButton {
                text: root.finish-label;
                primary: true;
                icon: "M 5 12 L 10 17 L 19 7";
                clicked => { root.finish(); }
            }
        }
    }
}
