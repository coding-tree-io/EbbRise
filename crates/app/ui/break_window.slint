// Break window, design "B1 · Ring, centred · chosen palette".

import { Palette, PillButton } from "widgets.slint";

export component BreakWindow inherits Window {
    in property <string> kind;
    in property <string> headline;
    in property <string> detail;
    in property <string> source;
    in property <string> number;
    in property <string> caption;
    // SVG path commands for the arc of time left, in the ring's 236 × 236 view box.
    in property <string> ring;
    // Share of the break passed, 0 to 1: the water level in the ring (design R1).
    in property <float> passed;
    in property <string> postpone-label;
    in property <string> skip-label;
    in property <string> finish-label;
    in property <bool> show-postpone;
    in property <bool> show-skip;
    in property <bool> show-finish;
    callback postpone();
    callback skip();
    callback finish();

    title: root.kind;
    icon: @image-url("icons/ebbrise.svg");
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI Variable Text";
    background: Palette.ground;

    // The glow centres on the ring. Its radius is 0.6 × the shorter side; the default radius
    // is half the diagonal (0.85 × the square's side), so the glow ends at 71 %.
    Rectangle {
        width: min(root.width, root.height) * 1.2;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.height * 0.3 - self.height / 2;
        background: @radial-gradient(circle, Palette.glow 0%, Palette.ground 71%);
    }

    VerticalLayout {
        alignment: center;
        spacing: 26px;
        padding: 32px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 236px;
                height: 236px;
                // The water rises inside the ring as the break passes; two wave layers slide
                // in opposite directions. Three 138 px wavelengths cover the 198 px circle.
                if root.passed > 0: Rectangle {
                    x: 19px;
                    y: 19px;
                    width: 198px;
                    height: 198px;
                    border-radius: 99px;
                    clip: true;
                    for layer in [
                        { drift: 1, depth: 0px, opacity: 0.55 },
                        { drift: -0.8, depth: 3px, opacity: 0.5 },
                    ]: Path {
                        property <float> shift: Math.mod(animation-tick() / 1ms * 0.022 * abs(layer.drift), 138);
                        x: (layer.drift > 0 ? -self.shift : self.shift - 138) * 1px;
                        y: (1 - root.passed) * 198px - 6px + layer.depth;
                        width: 414px;
                        height: 240px;
                        viewbox-width: 414;
                        viewbox-height: 240;
                        commands: "M 0 6 C 23 -2 46 -2 69 6 C 92 14 115 14 138 6 C 161 -2 184 -2 207 6 C 230 14 253 14 276 6 C 299 -2 322 -2 345 6 C 368 14 391 14 414 6 L 414 240 L 0 240 Z";
                        fill: @linear-gradient(180deg, Palette.water-top 0%, Palette.water-deep 100%);
                        opacity: layer.opacity;
                        animate y { duration: 1000ms; }
                    }
                }
                Path {
                    width: 236px;
                    height: 236px;
                    viewbox-width: 236;
                    viewbox-height: 236;
                    commands: "M 118 10 A 108 108 0 1 1 118 226 A 108 108 0 1 1 118 10";
                    stroke: Palette.ring-track;
                    stroke-width: 10px;
                }
                Path {
                    width: 236px;
                    height: 236px;
                    viewbox-width: 236;
                    viewbox-height: 236;
                    commands: root.ring;
                    stroke: @linear-gradient(135deg, Palette.ring-light 0%, Palette.ring-deep 100%);
                    stroke-width: 10px;
                    stroke-line-cap: round;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.number;
                        horizontal-alignment: center;
                        font-size: 80px;
                        font-weight: 300;
                        color: Palette.text;
                    }
                    Text {
                        text: root.caption;
                        horizontal-alignment: center;
                        font-size: 13px;
                        color: Palette.text-secondary;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            alignment: center;
            Text {
                text: root.kind.to-uppercase();
                horizontal-alignment: center;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1.4px;
                color: Palette.accent;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.headline;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-size: 32px;
                    font-weight: 600;
                    color: Palette.text;
                    max-width: 620px;
                }
            }
            if root.detail != "": HorizontalLayout {
                alignment: center;
                Text {
                    text: root.detail;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    font-size: 15px;
                    color: Palette.text-secondary;
                    max-width: 620px;
                }
            }
            if root.source != "": Text {
                text: root.source;
                horizontal-alignment: center;
                font-size: 12px;
                color: Palette.text-source;
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            if root.show-postpone: PillButton {
                text: root.postpone-label;
                icon: "M 12 3 A 9 9 0 1 1 12 21 A 9 9 0 1 1 12 3 M 12 7 L 12 12 L 15 14";
                clicked => { root.postpone(); }
            }
            if root.show-skip: PillButton {
                text: root.skip-label;
                primary: true;
                icon: "M 5 5 L 14 12 L 5 19 Z M 18 5 L 18 19";
                clicked => { root.skip(); }
            }
            if root.show-finish: PillButton {
                text: root.finish-label;
                primary: true;
                icon: "M 5 12 L 10 17 L 19 7";
                clicked => { root.finish(); }
            }
        }
    }
}
