// The Settings window's words. The defaults are EbbRise's English; for another language the app
// sets the ones Stretchly's translations cover with the same meaning, and clears the hint
// under a translated title, so a row never mixes two languages.

export global Words {
    in property <string> general: "General";
    in property <string> schedule: "Schedule";
    in property <string> sounds: "Sounds";
    in property <string> about: "About";
    in property <string> show-breaks-as: "Show breaks as";
    in property <string> window: "Window";
    in property <string> full-screen: "Full screen";
    in property <string> show-ideas: "Show break ideas";
    in property <string> show-ideas-hint: "Each idea names the study behind it";
    in property <string> start-at-login: "Start at login";
    in property <string> language: "Language";
    in property <string> appearance: "APPEARANCE";
    in property <string> theme: "Theme";
    in property <string> system: "System";
    in property <string> light: "Light";
    in property <string> dark: "Dark";
    in property <string> mini-breaks: "MINI BREAKS";
    in property <string> long-breaks: "LONG BREAKS";
    in property <string> take-mini: "Take mini breaks";
    in property <string> take-mini-hint: "Short pauses for your eyes";
    in property <string> take-long: "Take long breaks";
    in property <string> take-long-hint: "Time to stand up and walk";
    in property <string> every: "Every";
    in property <string> for-length: "For";
    in property <string> notify-mini: "Notify before";
    in property <string> notify-mini-hint: "A notification shortly before";
    in property <string> notify-long: "Notify before";
    in property <string> notify-long-hint: "A notification shortly before";
    in property <string> strict-mini: "Strict mode";
    in property <string> strict-mini-hint: "No skipping or postponing";
    in property <string> strict-long: "Strict mode";
    in property <string> strict-long-hint: "No skipping or postponing";
    in property <string> version: "Version ";
    in property <string> tagline: "Break reminders for Windows. Every break idea names the study behind it.";
    in property <string> restore-defaults: "Restore defaults";
}
