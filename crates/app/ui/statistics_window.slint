// Statistics window: concept D4-A for one day, design C2 for a week or a month, and the P2
// shoreline of the last 14 days (docs/workrave-features.md, feature 3).

import { Palette, RoundButton, Segmented } from "widgets.slint";
import { SectionLabel, Card } from "settings_window.slint";

// One day of the week or month chart.
export struct ChartBar {
    // Active time, hours.
    hours: float,
    // Breaks taken of the breaks that came, 0 to 1; below 0 when no break came.
    share: float,
    // Under the bar; empty for most days of a month.
    label: string,
    // For screen readers.
    description: string,
}

component Summary inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.divider;
    border-radius: 12px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 12px;
            color: Palette.text-secondary;
        }
        Text {
            text: root.value;
            font-size: 22px;
            font-weight: 600;
            color: Palette.text;
        }
    }
}

// The five counts of one break kind, in columns.
component Counts inherits Card {
    in property <[int]> values;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        for name[i] in ["Shown", "Completed", "Natural", "Skipped", "Postponed"]: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            accessible-role: text;
            accessible-label: name + ": " + root.values[i];
            Text {
                text: name;
                font-size: 12px;
                horizontal-alignment: center;
                color: Palette.text-secondary;
            }
            Text {
                text: root.values[i];
                font-size: 18px;
                horizontal-alignment: center;
                color: Palette.text;
            }
        }
    }
}

// The last 14 days on a shoreline (design P2): a shell for a day with no skipped break, a
// pebble for a day with one, bare sand for a day with no breaks; today has a ring.
component Shoreline inherits Rectangle {
    // 0 no breaks, 1 none skipped, 2 one or more skipped; the last is today.
    in property <[int]> days;
    // Weekday letters; the last is "Today".
    in property <[string]> letters;
    in property <int> streak;
    // The still water ends below the streak text (14 px + 30 px) and above the highest
    // wave edge less the swing (66 px − 3 px).
    property <length> still-depth: 50px;
    property <length> wave-height: 86px;
    // How far the water moves up and down.
    property <length> swing: 3px;

    accessible-role: text;
    accessible-label: root.streak + " day streak of days with no skipped break";
    height: 130px;
    border-radius: 12px;
    background: Palette.card;
    clip: true;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 560;
        viewbox-height: 130;
        commands: "M 0 70 C 90 60 180 78 280 68 C 380 58 470 76 560 66 L 560 130 L 0 130 Z";
        fill: Palette.sand;
    }
    // The water laps up and down the sand every 6 seconds.
    Rectangle {
        y: root.still-depth - 2px;
        height: root.wave-height + 2 * root.swing - self.y;
        clip: true;
        Path {
            y: root.swing * sin(animation-tick() / 1ms * 0.06deg) - parent.y;
            width: root.width;
            // Its edge lies over the sand's, so no gap opens while it moves.
            height: root.wave-height;
            viewbox-width: 560;
            viewbox-height: 86;
            commands: "M 0 0 L 560 0 L 560 73 C 470 80 380 66 280 75 C 180 84 90 68 0 77 Z";
            fill: Palette.water-deep;
            opacity: 0.55;
        }
    }
    // The water under the streak text stays still: text over the moving water flickered.
    // Opaque and drawn last, so its edge on the moving water leaves no light seam.
    Rectangle {
        y: 0px;
        height: root.still-depth;
        background: Palette.water-deep.mix(Palette.card, 0.55);
    }
    HorizontalLayout {
        x: 20px;
        y: 14px;
        width: root.width - 40px;
        height: 30px;
        spacing: 6px;
        Text {
            text: root.streak;
            font-size: 24px;
            font-weight: 600;
            color: Palette.text;
        }
        Text {
            text: "day streak";
            vertical-alignment: center;
            font-size: 13px;
            color: Palette.text-secondary;
            horizontal-stretch: 1;
        }
        Text {
            text: "Days with no skipped break";
            vertical-alignment: center;
            font-size: 12px;
            color: Palette.text-secondary;
        }
    }
    HorizontalLayout {
        y: 76px;
        height: 52px;
        padding-left: 16px;
        padding-right: 16px;
        for state[i] in root.days: VerticalLayout {
            property <bool> today: i == root.days.length - 1;
            horizontal-stretch: 1;
            alignment: end;
            spacing: 4px;
            padding-bottom: 2px;
            Rectangle {
                height: 30px;
                // The shells lie along an uneven tide line.
                Rectangle {
                    y: 3px * sin(i * 75deg);
                    if state == 1: Path {
                        width: 22px;
                        height: 17px;
                        viewbox-width: 24;
                        viewbox-height: 18;
                        commands: "M 12 18 C 2 16 0 4 12 0 C 24 4 22 16 12 18 Z M 12 18 L 7 3 M 12 18 L 12 1 M 12 18 L 17 3";
                        fill: today ? Palette.ring-light : Palette.accent;
                        stroke: Palette.card;
                        stroke-width: 0.8px;
                    }
                    if state == 2: Rectangle {
                        width: 7px;
                        height: 6px;
                        y: parent.height - 12px;
                        border-radius: 3px;
                        background: Palette.muted;
                    }
                    if today: Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        border-width: 1.5px;
                        border-color: Palette.accent;
                    }
                }
            }
            Text {
                text: root.letters[i];
                horizontal-alignment: center;
                font-size: 10px;
                color: Palette.text;
                opacity: 0.75;
            }
        }
    }
}

// Active time per day with the share of breaks taken (design C2).
component ActivityChart inherits Rectangle {
    in property <[ChartBar]> bars;
    // The top of the scale, hours.
    in property <float> top-hours;
    // The daily limit, hours; 0 when it is off.
    in property <float> limit-hours;
    property <length> left-margin: 36px;
    property <length> plot-top: 14px;
    property <length> plot-height: 150px;
    property <length> plot-width: root.width - root.left-margin - 10px;

    height: 230px;
    for grid in [0, 0.5, 1]: Rectangle {
        y: root.plot-top + (1 - grid) * root.plot-height;
        height: 1px;
        Rectangle {
            x: root.left-margin;
            width: root.plot-width;
            background: Palette.divider;
        }
        Text {
            x: 0;
            y: -7px;
            width: root.left-margin - 6px;
            horizontal-alignment: right;
            text: round(root.top-hours * grid) + "h";
            font-size: 10px;
            color: Palette.text-secondary;
        }
    }
    if root.limit-hours > 0 && root.limit-hours <= root.top-hours: Rectangle {
        x: root.left-margin;
        y: root.plot-top + (1 - root.limit-hours / root.top-hours) * root.plot-height;
        width: root.plot-width;
        height: 2px;
        for dash in floor(root.plot-width / 9px): Rectangle {
            x: dash * 9px;
            width: 5px;
            background: Palette.accent;
        }
        Text {
            x: root.plot-width - 80px;
            y: -16px;
            width: 80px;
            horizontal-alignment: right;
            text: "daily limit";
            font-size: 10px;
            color: Palette.accent;
        }
    }
    HorizontalLayout {
        x: root.left-margin;
        y: root.plot-top;
        width: root.plot-width;
        height: root.plot-height + 60px;
        for bar in root.bars: Rectangle {
            property <length> bar-width: min(self.width * 0.6, 44px);
            property <length> dot: min(6px, self.width * 0.3);
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: bar.description;
            Rectangle {
                x: (parent.width - parent.bar-width) / 2;
                width: parent.bar-width;
                height: min(bar.hours / root.top-hours, 1) * root.plot-height;
                y: root.plot-height - self.height;
                border-radius: min(4px, parent.bar-width / 3);
                background: Palette.accent;
                opacity: 0.9;
            }
            if bar.share >= 0: Rectangle {
                x: (parent.width - self.width) / 2;
                y: root.plot-height + 16px - self.height / 2;
                width: parent.dot * 2;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: Palette.muted;
                Rectangle {
                    width: parent.width * sqrt(bar.share);
                    height: self.width;
                    border-radius: self.width / 2;
                    background: bar.share >= 1 ? Palette.accent : Palette.ring-deep;
                }
            }
            Text {
                x: (parent.width - self.width) / 2;
                y: root.plot-height + 30px;
                width: 56px;
                horizontal-alignment: center;
                text: bar.label;
                font-size: 11px;
                color: Palette.text-secondary;
            }
        }
    }
}

export component StatisticsWindow inherits Window {
    // For the title bar, which Windows draws.
    out property <bool> dark-mode: Palette.dark;
    // 0 one day, 1 a week, 2 a month.
    in property <int> range;
    // The day, week or month shown.
    in property <string> day;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <string> active-time;
    in property <string> completed;
    in property <[int]> mini;
    in property <[int]> long;
    // Empty when no daily-limit reminder came that day.
    in property <string> daily-limit;
    // Week and month.
    in property <[ChartBar]> bars;
    in property <float> top-hours;
    in property <float> limit-hours;
    in property <string> taken-share;
    in property <string> skipped;
    // The shoreline.
    in property <[int]> shore;
    in property <[string]> shore-letters;
    in property <int> streak;
    callback back();
    callback forward();
    callback range-changed(int);
    callback dark-mode-changed(bool);
    changed dark-mode => { root.dark-mode-changed(self.dark-mode); }

    property <string> unit: ["day", "week", "month"][root.range];

    title: "EbbRise statistics";
    icon: @image-url("icons/ebbrise.svg");
    preferred-width: 640px;
    min-width: 560px;
    min-height: 700px;
    background: Palette.ground;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    VerticalLayout {
        padding: 28px;
        padding-left: 36px;
        padding-right: 36px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Statistics";
                font-size: 28px;
                font-weight: 600;
                color: Palette.text;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                RoundButton {
                    label: "Previous " + root.unit;
                    icon: "M 15 6 L 9 12 L 15 18";
                    enabled: root.can-go-back;
                    clicked => { root.back(); }
                }
            }
            Text {
                text: root.day;
                min-width: 140px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.text;
            }
            VerticalLayout {
                alignment: center;
                RoundButton {
                    label: "Next " + root.unit;
                    icon: "M 9 6 L 15 12 L 9 18";
                    enabled: root.can-go-forward;
                    clicked => { root.forward(); }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Segmented {
                options: ["Day", "Week", "Month"];
                current: root.range;
                changed(index) => { root.range-changed(index); }
            }
        }
        Rectangle { height: 4px; }
        Shoreline {
            days: root.shore;
            letters: root.shore-letters;
            streak: root.streak;
        }
        Rectangle { height: 4px; }
        if root.range == 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                Summary {
                    label: "Active time";
                    value: root.active-time;
                }
                Summary {
                    label: "Breaks completed";
                    value: root.completed;
                }
            }
            Rectangle { height: 8px; }
            SectionLabel { text: "MINI BREAKS"; }
            Counts { values: root.mini; }
            Rectangle { height: 8px; }
            SectionLabel { text: "LONG BREAKS"; }
            Counts { values: root.long; }
            if root.daily-limit != "": Text {
                text: root.daily-limit;
                wrap: word-wrap;
                color: Palette.text-secondary;
            }
        }
        if root.range != 0: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                Summary {
                    label: "Active time";
                    value: root.active-time;
                }
                Summary {
                    label: "Breaks taken";
                    value: root.taken-share;
                }
                Summary {
                    label: "Skipped";
                    value: root.skipped;
                }
            }
            Rectangle { height: 8px; }
            SectionLabel { text: "ACTIVE TIME AND BREAKS"; }
            Card {
                ActivityChart {
                    bars: root.bars;
                    top-hours: root.top-hours;
                    limit-hours: root.limit-hours;
                }
            }
            HorizontalLayout {
                spacing: 16px;
                padding-left: 4px;
                Text {
                    text: "Bar: active time";
                    font-size: 12px;
                    color: Palette.text-secondary;
                }
                Text {
                    text: "Dot: share of breaks taken, full when none skipped";
                    font-size: 12px;
                    color: Palette.text-secondary;
                }
            }
        }
    }
}
